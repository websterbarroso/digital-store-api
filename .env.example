# Porta HTTP da API
PORT=3000
# URL pública da API (usada para montar a URL das imagens dos produtos)
APP_URL=http://localhost:3000

# Banco de dados: "mysql" (padrão do projeto) ou "sqlite" (para rodar sem instalar MySQL)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=digital_store
# Usado apenas quando DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Segredo e validade do token JWT
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1d

# Origem liberada no CORS (front-end). Use * para liberar todas.
CORS_ORIGIN=*
